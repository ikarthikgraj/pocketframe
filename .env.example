# ==============================================================================
# POCKETFRAME ENVIRONMENT CONFIGURATION FOR VERCEL DEPLOYMENT
# ==============================================================================

# 1. AI Story Planning (OpenAI)
POCKETFRAME_PLANNER_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini

# 2. Voice Narration TTS (Google Gemini / ElevenLabs)
# Choose provider: 'google' (or 'gemini') or 'elevenlabs'
POCKETFRAME_TTS_PROVIDER=google
GEMINI_TTS_API_KEY=your_google_gemini_api_key_here
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# Optional ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# 3. AI Video Generation (Replicate / Seedance / Kling / Veo)
# Choose provider: 'real' (Replicate) or 'mock'
POCKETFRAME_VIDEO_PROVIDER=mock
REPLICATE_API_TOKEN=your_replicate_api_token_here

# 4. Storage & Vercel Serverless Data Directory
# On Vercel, serverless functions automatically default data directory to /tmp
POCKETFRAME_DATA_DIR=/tmp
