# Optional: absolute or relative directory for the local SQLite database and media.
POCKETFRAME_DATA_DIR=./data

# Providers default to local mock implementations. Keep all real-provider values server-side in .env.local.
POCKETFRAME_PLANNER_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-4o-mini
# Optional path to the supplied narrative-director brief. It is read only on the server.
# NARRATION_DIRECTOR_PROMPT_PATH=../narration_system.txt

POCKETFRAME_TTS_PROVIDER=mock
# ElevenLabs production voice.
# ELEVENLABS_API_KEY=
# Optional override; the requested project voice is the default.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional: ELEVENLABS_ENDPOINT=https://api.elevenlabs.io/v1

# Legacy optional Gemini adapter.
# GEMINI_TTS_API_KEY=
# GEMINI_TTS_MODEL=
# GEMINI_TTS_VOICE=
# Optional override for compatible Gemini API endpoints.
# GEMINI_TTS_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
